      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from IPython.display import display\n",
        "\n",
        "data_control = {\n",
        "    \"Yes\": [\"\", \"\", \"\", \"\", \"X\", \"\", \"\", \"X\", \"\", \"\", \"\", \"X\", \"x\", \"X\"],\n",
        "    \"No\": [\"X\", \"X\", \"X\", \"X\", \"\", \"X\", \"X\", \"\", \"X\", \"X\", \"X\", \"\", \"\", \"\"],\n",
        "    \"Control\": [\"Least Privilege\", \"Disaster recovery plans\", \"Password policies\", \"Separation of duties\", \"Firewall\", \"Intrusion Detection System (IDS)\", \"Backups\", \"Antivirus software\", \"Monitoring, maintenance and manual intervention for legacy systems\", \"Encryption\", \"Password management system\", \"Locks (offices, storefront, warehouse)\", \"Closed-circuit television (CCTV) surveillance\", \"Fire detection/prevention (fire alarm, sprinkler system, etc.)\"],\n",
        "    \"Explanation\": [\"Currently, all employees have access to customer data; privileges must be limited to reduce the risk of a breach.\", \"There are no disaster recovery plans. These must be implemented to ensure business continuity.\", \"Password requirements for employees are minimal, which could allow a threat actor to more easily access secure data or other assets via work equipment or the internal network.\", \"Must be implemented to reduce the possibility of fraud or access to critical data, as the company CEO currently manages daily operations and payroll.\", \"The existing firewall blocks traffic based on a properly defined set of security rules.\", \"The IT department needs an IDS to help identify potential intrusions by threat actors.\", \"The IT department needs to have backups of critical data in case of a security breach to ensure business continuity.\", \"Antivirus software is installed and monitored regularly by the IT department.\", \"The asset list notes the use of legacy systems. Risk assessment indicates these systems are monitored and maintained, but there is no regular schedule for this task and procedures/policies related to intervention are unclear, which could put these systems at risk of a breach.\", \"Currently, encryption is not used; implementing it would provide greater confidentiality of sensitive information.\", \"There is currently no password management system; implementing this control would improve the productivity of the IT department and other employees in case of password issues.\", \"The physical store location, which includes the main offices, the storefront, and the product warehouse, has sufficient locks.\", \"Security cameras are installed and functioning at the physical store location.\", \"The physical location of 'Llave del Chaco' has a functional fire detection and prevention system.\"]\n",
        "}\n",
        "tabla_control = pd.DataFrame(data_control)\n",
